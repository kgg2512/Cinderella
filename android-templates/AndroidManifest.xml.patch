<!--
  신데렐라 — Android 권한 선언 패치
  배포 경로: android/app/src/main/AndroidManifest.xml 에 병합
-->

<!-- ===== 권한 선언 (manifest 태그 안, application 태그 밖) ===== -->

<!-- 인터넷 (Supabase API, Toss 결제) -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- 카메라 (상품 촬영) -->
<uses-permission android:name="android.permission.CAMERA" />

<!-- 사진 라이브러리 (Android 13 이상) -->
<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

<!-- 사진 라이브러리 (Android 12 이하 fallback) -->
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />

<!-- 알림 (Android 13+) -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- 진동 -->
<uses-permission android:name="android.permission.VIBRATE" />

<!-- ===== uses-feature (선택적) ===== -->
<uses-feature android:name="android.hardware.camera" android:required="false" />

<!-- ===== application 태그 속성 추가 ===== -->
<!--
  android:usesCleartextTraffic="false"  (CISO 보안 필수)
  android:networkSecurityConfig="@xml/network_security_config"
-->

<!-- ===== OAuth 딥링크 Intent Filter (activity 태그 안에 추가) ===== -->
<!--
  배포 위치: android/app/src/main/AndroidManifest.xml
  <activity android:name=".MainActivity" ...> 블록 안에 아래 intent-filter 추가

  Supabase Auth redirect URL: com.g2company.cinderella://auth/callback
  Google Cloud Console → OAuth 동의화면 → 승인된 리디렉션 URI에도 동일하게 추가 필요
-->
<intent-filter android:autoVerify="false">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <!--
      android:scheme: 앱 고유 커스텀 스킴 (소문자, 점 허용)
      android:host: 경로의 첫 번째 세그먼트 (auth)
    -->
    <data
        android:scheme="com.g2company.cinderella"
        android:host="auth" />
</intent-filter>
