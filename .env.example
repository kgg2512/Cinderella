# 신데렐라 환경변수 템플릿
# 이 파일을 복사해서 .env.local 로 이름 변경 후 실제 값 입력
# .env.local 은 절대 git에 커밋하지 말 것 (.gitignore 확인)

# Supabase 연결 정보 (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase OAuth 딥링크 리디렉트 URL (Android: com.g2company.cinderella://auth/callback)
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs 에 등록 필요
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=com.g2company.cinderella://auth/callback
